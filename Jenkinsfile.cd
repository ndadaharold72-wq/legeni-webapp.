// TP 3.8 : staging automatique, validation humaine en main, production avec rollback.
pipeline {
    agent any

    environment {
        IMAGE = 'legeni-webapp'
        VERSION = "1.0.${env.BUILD_NUMBER}"
        COMPOSE = 'docker compose -f deploy/docker-compose.deploy.yml'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Tests unitaires') {
            steps { sh 'docker build --target test -t $IMAGE:test .' }
        }
        stage('Build image') {
            steps { sh 'docker build --build-arg APP_VERSION=$VERSION -t $IMAGE:$VERSION .' }
        }
        stage('Déploiement staging') {
            environment { REDIS_PASSWORD = credentials('redis-password-staging') }
            steps {
                sh '''
                    IMAGE_REF="$IMAGE:$VERSION" APP_ENV=staging APP_COLOR='#bf8700' PORT=8081 \\
                        $COMPOSE -p legeni-staging up -d --wait
                    ./deploy/smoke-test.sh legeni-staging "$VERSION"
                '''
            }
        }
        stage('Validation production') {
            when { branch 'main' }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: "Déployer la version ${VERSION} en production ?", ok: 'Déployer'
                }
            }
        }
        stage('Déploiement production') {
            when { branch 'main' }
            environment { REDIS_PASSWORD = credentials('redis-password-prod') }
            steps {
                script {
                    env.PREVIOUS_IMAGE = sh(
                        script: "docker inspect -f '{{.Config.Image}}' legeni-prod-web-1 2>/dev/null || echo none",
                        returnStdout: true
                    ).trim()
                    try {
                        sh '''
                            IMAGE_REF="$IMAGE:$VERSION" APP_ENV=prod APP_COLOR='#2da44e' PORT=8082 \\
                                $COMPOSE -p legeni-prod up -d --wait
                            ./deploy/smoke-test.sh legeni-prod "$VERSION"
                        '''
                    } catch (err) {
                        if (env.PREVIOUS_IMAGE != 'none') {
                            sh '''
                                IMAGE_REF="$PREVIOUS_IMAGE" APP_ENV=prod APP_COLOR='#2da44e' PORT=8082 \\
                                    $COMPOSE -p legeni-prod up -d --wait
                            '''
                        }
                        error("Échec production ; rollback vers ${env.PREVIOUS_IMAGE} effectué si une version précédente existait")
                    }
                }
            }
        }
    }

    post {
        success { echo "${env.JOB_NAME} #${env.BUILD_NUMBER} : ${VERSION} déployée" }
        failure { echo "${env.JOB_NAME} #${env.BUILD_NUMBER} en échec ; consulter la console Jenkins" }
    }
}
